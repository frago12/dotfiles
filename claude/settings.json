{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(~/dev/worktrees/**)",
      "Read(~/dev/frago/dotfiles/github/pr-template.md)",
      "Bash(/bin/ls:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(direnv:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(mise:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(prettier:*)",
      "Bash(pwd:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(rm:*)",
      "Bash(sed:*)",
      "Bash(tar:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(wget:*)",
      "Bash(zizmor:*)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:zizmor.sh)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "fable[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path' /dev/stdin); pnpm exec prettier --write --ignore-unknown \"$(realpath \"$file\")\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); session_id=$(echo \"$input\" | jq -r '.session_id'); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); git_info=\"\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" branch --show-current 2>/dev/null); [ -z \"$branch\" ] && branch=$(git -C \"$cwd\" rev-parse --short HEAD 2>/dev/null); if ! git -C \"$cwd\" diff-index --quiet HEAD -- 2>/dev/null; then status=\"*\"; else status=\"\"; fi; git_info=\" git:($branch$status)\"; fi; context_info=\"\"; [ -n \"$remaining\" ] && context_info=\" ctx:${remaining}%\"; session_short=$(echo \"$session_id\" | cut -c1-8); printf \"%s%s%s [%s]\" \"$cwd\" \"$git_info\" \"$context_info\" \"$session_short\""
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "codex@openai-codex": true,
    "swift-lsp@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "shopify-ai-toolkit@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
