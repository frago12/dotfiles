#!/bin/bash
############################
# Thanks to Michael Smalley: http://blog.smalleycreative.com/tutorials/using-git-and-github-to-manage-your-dotfiles/
############################

########## Variables
dir=/path/to/dotfile # dotfiles directory
olddir=/path/to/dotfile_old # old dotfiles backup directory
files="zshrc zshrc.d secrets.d bin claude agents ripgreprc" # list of files/folders to symlink in
##########

# Install Homebrew
if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "Homebrew is already installed. Skipping.."
fi

# create dotfiles_old in homedir
echo "Creating $olddir for backup of any existing dotfiles in ~"
mkdir -p $olddir
echo "...done"

# Change to the dotfiles directory
echo "Changing to the $dir directory"
cd $dir
echo "...done"

# Replace existing homedir files with symlinks, backing up real files.
# Skip dest if it's already the right symlink so a re-run doesn't ln into the
# linked directory (which creates repo/dir/dir loops).
for file in $files; do
  target="$dir/$file"
  dest="$HOME/.$file"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$target" ]]; then
    echo "Already linked $dest"
    continue
  fi

  if [[ -L "$dest" ]]; then
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    backup="$olddir/.$file"
    if [[ -e "$backup" || -L "$backup" ]]; then
      mv "$backup" "$olddir/.$file.$(date +%Y%m%d%H%M%S)"
    fi
    echo "Backing up $dest to $olddir"
    mv "$dest" "$olddir/"
  fi

  echo "Creating symlink to $file in home directory."
  ln -sfn "$target" "$dest"
done

# Symlink ~/.config apps (nvim, etc.)
mkdir -p ~/.config
ln -sfn "$dir/config/nvim" ~/.config/nvim
ln -sfn "$dir/config/starship.toml" ~/.config/starship.toml

# Skills live in agents/skills, linked to ~/.agents above. Codex and other
# AGENTS.md agents read ~/.agents/skills directly. Claude Code and Grok do not,
# so link every skill into their own directories.
mkdir -p "$HOME/.claude/skills" "$HOME/.grok/skills" "$HOME/.config/agents/skills"
for skill_path in "$HOME"/.agents/skills/*/; do
  skill=$(basename "$skill_path")
  for skills_dir in "$HOME/.claude/skills" "$HOME/.grok/skills" "$HOME/.config/agents/skills"; do
    # A real directory is managed by its own tool (Rex installs one), leave it.
    if [[ -e "$skills_dir/$skill" && ! -L "$skills_dir/$skill" ]]; then
      continue
    fi
    ln -sfn "$HOME/.agents/skills/$skill" "$skills_dir/$skill"
  done
done

# Global agent instructions live in agents/AGENTS.md. Claude Code reads them
# through the claude/CLAUDE.md symlink, Codex needs its own link.
mkdir -p "$HOME/.codex"
ln -sfn "$HOME/.agents/AGENTS.md" "$HOME/.codex/AGENTS.md"

# Install Claude marketplaces
claude  plugin marketplace add https://github.com/anthropics/claude-plugins-official

# Install Codex plugins
codex plugin marketplace add https://github.com/postmanlabs/postman-plugin.git
while read -r plugin; do
  echo "Adding codex plugin $plugin..."
  codex plugin add "$plugin"
done < "$dir/codex/plugins.txt"

# skills CLI (https://www.npmjs.com/package/skills). Skills added with
# `skills add --global` land in agents/skills, so commit them from there.
npm install -g skills@latest
