#!/bin/bash
############################
# Thanks to Michael Smalley: http://blog.smalleycreative.com/tutorials/using-git-and-github-to-manage-your-dotfiles/
############################

########## Variables
dir=/path/to/dotfile # dotfiles directory
olddir=/path/to/dotfile_old # old dotfiles backup directory
files="zshrc zshrc.d secrets.d bin claude tmux.conf tmux hyper.js ripgreprc" # list of files/folders to symlink in
##########

# Install Homebrew
if test ! $(which brew); then
  e_header "Installing Homebrew"
  ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
else
  echo "Homebrew is already installed. Skipping.."
fi

# create dotfiles_old in homedir
echo "Creating $olddir for backup of any existing dotfiles in ~"
mkdir -p $olddir
echo "...done"

# Change to the dotfiles directory
echo "Changing to the $dir directory"
cd $dir
echo "...done"

# Replace existing homedir files with symlinks, backing up real files.
# Skip dest if it's already the right symlink so a re-run doesn't ln into the
# linked directory (which creates repo/dir/dir loops).
for file in $files; do
  target="$dir/$file"
  dest="$HOME/.$file"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$target" ]]; then
    echo "Already linked $dest"
    continue
  fi

  if [[ -L "$dest" ]]; then
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    backup="$olddir/.$file"
    if [[ -e "$backup" || -L "$backup" ]]; then
      mv "$backup" "$olddir/.$file.$(date +%Y%m%d%H%M%S)"
    fi
    echo "Backing up $dest to $olddir"
    mv "$dest" "$olddir/"
  fi

  echo "Creating symlink to $file in home directory."
  ln -sfn "$target" "$dest"
done

# Symlink ~/.config apps (nvim, etc.)
mkdir -p ~/.config
ln -sfn "$dir/config/nvim" ~/.config/nvim

# Install Claude marketplaces
claude  plugin marketplace add https://github.com/anthropics/claude-plugins-official
claude  plugin marketplace add https://github.com/EveryInc/compound-engineering-plugin

# Install agent skills (https://www.npmjs.com/package/skills)
npm install -g skills@latest
skills add vercel-labs/skills --skill find-skills --global --agent claude-code cursor grok --yes
skills add dmmulroy/anti-slop --skill install-anti-slop --global --agent claude-code cursor grok --yes
skills add wshobson/agents --skill mobile-ios-design --global --agent claude-code cursor grok --yes
